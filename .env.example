# 1. Copy this file and rename it to .env.local
# 2. Fill in the values below.

# ───────────────────────────────────────────────
# LiveKit (required) — from your LiveKit Cloud project dashboard
# ───────────────────────────────────────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# URL pointing to the LiveKit server. (example: wss://my-project.livekit.cloud)
LIVEKIT_URL=

# ───────────────────────────────────────────────
# Google OAuth (required) — Google Cloud Console → APIs & Services → Credentials
# ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ───────────────────────────────────────────────
# NextAuth (required)
# ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Must exactly match the app URL (http://localhost:3000 in dev, your domain in prod)
NEXTAUTH_URL=http://localhost:3000

# ───────────────────────────────────────────────
# Admin console (optional) — password for /admin (defaults to "admin123")
# ───────────────────────────────────────────────
ADMIN_PASSWORD=

# ───────────────────────────────────────────────
# Optional
# ───────────────────────────────────────────────
# Recording (S3)
# S3_KEY_ID=
# S3_KEY_SECRET=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
